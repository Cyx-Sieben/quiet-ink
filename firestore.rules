rules_version = '2';

// Quiet Ink security rules.
// Deploy with:  npm run deploy:rules   (see SETUP.md)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function str(v, max) { return v is string && v.size() <= max; }
    function photoOk(data) {
      return !(('photoData' in data) && data.photoData != null
        && (!(data.photoData is string) || data.photoData.size() > 200000));
    }

    // ---------------------------------------------------------------- nicknames
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---------------------------------------------------------------- public profiles
    // The profile owns a reserved nickname (checked against /usernames after the write).
    function ownsNickname(data) {
      return getAfter(/databases/$(database)/documents/usernames/$(data.nicknameLower)).data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if isMe(uid)
        && str(request.resource.data.nickname, 20)
        && request.resource.data.nicknameLower == request.resource.data.nickname.lower()
        && str(request.resource.data.bio, 160)
        && photoOk(request.resource.data)
        && ownsNickname(request.resource.data);
      allow delete: if isMe(uid);

      // Private progress, weekly records and the clock check: owner only.
      match /private/{docId} {
        allow read, write: if isMe(uid);
      }
      match /weeks/{week} {
        allow read, write: if isMe(uid);
      }
    }

    // ---------------------------------------------------------------- friends
    match /friendRequests/{reqId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && reqId == request.resource.data.from + '_' + request.resource.data.to
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && !(request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.to)/private/state).data.get('blocked', []));
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    // A friendship can only be created by the person who RECEIVED the request.
    function receivedRequest(a, b) {
      return (exists(/databases/$(database)/documents/friendRequests/$(a + '_' + b))
              && get(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.to == request.auth.uid)
          || (exists(/databases/$(database)/documents/friendRequests/$(b + '_' + a))
              && get(/databases/$(database)/documents/friendRequests/$(b + '_' + a)).data.to == request.auth.uid);
    }

    match /friendships/{pair} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pair == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && receivedRequest(request.resource.data.members[0], request.resource.data.members[1]);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }
  }
}
